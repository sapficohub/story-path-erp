# Create and publish a website webhook in TeleCRM, then paste its full URL here.
TELECRM_WEBHOOK_URL=https://next-api.telecrm.in/your-workspace-id/webhook/websiteform

# Optional: set this only when the TeleCRM webhook uses Bearer-token authentication.
TELECRM_WEBHOOK_SECRET=

# Resend email notifications for every website lead.
# Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxx

# Must use a sender address on a domain verified in Resend.
RESEND_FROM_EMAIL=Next-Gen ERP Solutions <leads@nextgenerpsolutions.com>

# Inbox that should receive website enquiries.
LEAD_NOTIFICATION_EMAIL=hello@nextgenerpsolutions.com

# Displayed in the automatic confirmation email sent to the customer.
COMPANY_PHONE_NUMBER=+91 90003 33859
